Algoritmo Interes
	Definir capital, tasa, tiempo, interesSimple Como Real
	tasa <- 0.08 
	Escribir "La tasa de interés es: ", tasa * 100, "%"
    Escribir "Ingrese el capital:"
    Leer capital
    Escribir "Ingrese el tiempo:"
    Leer tiempo
    interesSimple <- capital * tasa * tiempo
    Escribir "El interés simple es: ", interesSimple
	
FinAlgoritmo
